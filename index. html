<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>TournaX - Compete. Play. Win.</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>*{font-family:Inter}.card:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,0,0,.08)}</style>
</head>
<body class="bg-[#fcfcfc] text-zinc-900">
<div id="app"></div>
<script>
const CATS=["All","Free Fire","PUBG Mobile","BGMI","eFootball","COD Mobile","Valorant"];
const TOURNAMENTS=[
{id:"tx1",title:"TournaX Weekly Clash",game:"Free Fire",cat:"Free Fire",entry:20,prize:2000,total:100,joined:68,date:"22 Sep",time:"9:00 PM",status:"upcoming",banner:"🔥",rules:"No hack. Solo Battle Royale. Prize in wallet in 30 min."},
{id:"tx2",title:"TournaX Battle Royale",game:"PUBG Mobile",cat:"PUBG Mobile",entry:50,prize:5000,total:100,joined:92,date:"21 Sep",time:"8:00 PM",status:"live",banner:"🎯",rules:"Erangel only. Team size 4."},
{id:"tx3",title:"TournaX Pro League",game:"eFootball",cat:"eFootball",entry:100,prize:10000,total:32,joined:14,date:"23 Sep",time:"7:30 PM",status:"upcoming",banner:"⚽",rules:"Pro league format."},
{id:"tx4",title:"Clash Kings Cup",game:"Clash Royale",cat:"Clash Royale",entry:0,prize:1500,total:128,joined:110,date:"21 Sep",time:"Live",status:"live",banner:"👑",rules:"Free entry."},
];
let DB={
 user: JSON.parse(localStorage.getItem('tx_user')||'null'),
 balance: Number(localStorage.getItem('tx_bal')||'850'),
 orders: JSON.parse(localStorage.getItem('tx_orders')||'[]'),
 trx: JSON.parse(localStorage.getItem('tx_trx')||'[]')
};
function save(){localStorage.setItem('tx_user',JSON.stringify(DB.user));localStorage.setItem('tx_bal',DB.balance);localStorage.setItem('tx_orders',JSON.stringify(DB.orders));localStorage.setItem('tx_trx',JSON.stringify(DB.trx));}
let state={route:location.hash.slice(1)||'/',cat:"All",search:"",sel:null};
function nav(r){location.hash=r;state.route=r;render();scrollTo(0,0)}
function TC(t){return `<div onclick="openT('${t.id}')" class="card bg-white border rounded-[18px] p-4 cursor-pointer"><div class="flex gap-3"><div class="w-12 h-12 bg-zinc-100 rounded-[12px] flex items-center justify-center text-xl">${t.banner}</div><div class="flex-1"><div class="flex justify-between"><b class="text-[14px]">${t.title}</b><span class="text-[10px] px-2 py-1 rounded-full ${t.status=='live'?'bg-red-500 text-white':'bg-zinc-900 text-white'} uppercase">${t.status}</span></div><p class="text-[12px] text-zinc-500">${t.game} • ${t.date} ${t.time}</p><div class="flex gap-2 mt-2"><span class="bg-zinc-50 border rounded-full px-3 py-1 text-[11px]">৳${t.entry} Entry</span><span class="bg-amber-50 border border-amber-200 text-amber-700 rounded-full px-3 py-1 text-[11px] font-bold">৳${t.prize} Prize</span></div></div></div></div>`}
window.openT=(id)=>{state.sel=TOURNAMENTS.find(x=>x.id==id);nav('/tournaments/'+id)}
function render(){
 const r=state.route; if(!DB.user &&!['/login','/register','/forgot-password'].includes(r)){ nav('/login'); return;}
 let h=`<header class="sticky top-0 z-20 bg-white/90 backdrop-blur border-b"><div class="max-w-[1100px] mx-auto px-4 h-[64px] flex justify-between items-center"><div class="flex gap-2 items-center"><div class="w-9 h-9 bg-zinc-900 text-white rounded-[10px] flex items-center justify-center font-black">TX</div><div><div class="font-black leading-none">TournaX</div><div class="text-[9px] tracking-widest text-zinc-500">COMPETE. PLAY. WIN.</div></div></div><div class="hidden md:flex gap-5 text-[14px]"><button onclick="nav('/')">Home</button><button onclick="nav('/tournaments')">Tournaments</button><button onclick="nav('/orders')">My Orders</button><button onclick="nav('/wallet')">Wallet</button><button onclick="nav('/profile')">Profile</button></div><div class="flex gap-2 items-center"><span class="hidden md:block text-[12px] font-bold">৳${DB.balance}</span><button onclick="nav('/profile')" class="w-9 h-9 rounded-full bg-zinc-900 text-white font-bold">${DB.user?DB.user.name[0]:'U'}</button></div></div></header>`;
 let html='';
 if(r=='/login'){html=`<div class="max-w-[400px] mx-auto px-4 py-20"><div class="bg-white border rounded-[24px] p-8"><h1 class="text-[26px] font-black">Welcome Back</h1><p class="text-[13px] text-zinc-500 mt-1">Login to TournaX - Firebase Ready</p><input id="le" placeholder="Email" class="w-full mt-6 border rounded-[12px] px-4 py-3"><input id="lp" type="password" placeholder="Password" class="w-full mt-3 border rounded-[12px] px-4 py-3"><button onclick="doLogin()" class="w-full mt-4 bg-zinc-900 text-white py-3 rounded-full font-bold">Login</button><button onclick="nav('/register')" class="w-full mt-3 border py-3 rounded-full text-[13px]">Create Account</button><button onclick="nav('/forgot-password')" class="w-full mt-2 text-[12px] text-zinc-500">Forgot Password?</button><div class="mt-6 bg-zinc-50 border rounded-[12px] p-3 text-[11px]"><b>Demo:</b> any email/pass works. Later connect Firebase Auth. bKash: 01344758887</div></div></div>`}
 else if(r=='/register'){html=`<div class="max-w-[400px] mx-auto px-4 py-16"><div class="bg-white border rounded-[24px] p-8"><h1 class="text-[26px] font-black">Create Account</h1><input id="rn" placeholder="Full Name" class="w-full mt-6 border rounded-[12px] px-4 py-3"><input id="re" placeholder="Email" class="w-full mt-3 border rounded-[12px] px-4 py-3"><input id="rp" type="password" placeholder="Password" class="w-full mt-3 border rounded-[12px] px-4 py-3"><input id="rph" placeholder="Phone - 01344758887" class="w-full mt-3 border rounded-[12px] px-4 py-3"><button onclick="doReg()" class="w-full mt-4 bg-zinc-900 text-white py-3 rounded-full font-bold">Sign Up</button><button onclick="nav('/login')" class="text-[13px] mt-4 w-full">Already have account? Login</button></div></div>`}
 else if(r=='/'||r==''){html=`<div class="max-w-[1100px] mx-auto px-4 py-5"><div class="grid md:grid-cols-3 gap-4"><div class="md:col-span-2 bg-zinc-900 text-white rounded-[24px] p-7"><p class="text-zinc-400 text-[11px] tracking-widest">TOURNAX OFFICIAL</p><h1 class="text-[34px] font-black leading-tight mt-1">Compete.<br>Play. Win.</h1><p class="text-zinc-400 text-[13px] mt-2 max-w-[340px]">Real tournament platform - Join, Pay with bKash 01344758887, Win prize to wallet.</p><button onclick="nav('/tournaments')" class="mt-5 bg-white text-black px-6 py-2.5 rounded-full font-bold text-[13px]">Browse Tournaments</button></div><div class="bg-white border rounded-[24px] p-5"><h3 class="font-bold">Wallet</h3><div class="mt-3 bg-zinc-50 border rounded-[16px] p-4"><div class="text-[11px] text-zinc-500">AVAILABLE</div><div class="text-[30px] font-black">৳${DB.balance}</div></div><div class="grid grid-cols-2 gap-2 mt-3"><button onclick="nav('/wallet/deposit')" class="bg-zinc-900 text-white py-2.5 rounded-full text-[13px] font-bold">Deposit</button><button onclick="nav('/wallet/withdraw')" class="border py-2.5 rounded-full text-[13px] font-bold">Withdraw</button></div></div></div><div class="mt-6 flex gap-2 overflow-auto">${CATS.map(c=>`<button onclick="state.cat='${c}';render()" class="px-4 py-2 rounded-full border text-[13px] ${state.cat==c?'bg-zinc-900 text-white':'bg-white'}">${c}</button>`).join('')}</div><div class="grid md:grid-cols-3 gap-3 mt-5">${TOURNAMENTS.filter(t=>state.cat=='All'||t.cat==state.cat).map(TC).join('')}</div></div>`}
 else if(r.startsWith('/tournaments/')){const t=state.sel||TOURNAMENTS[0];html=`<div class="max-w-[800px] mx-auto px-4 py-6"><button onclick="nav('/tournaments')" class="text-[13px]">← Back</button><div class="bg-white border rounded-[24px] overflow-hidden mt-4"><div class="h-[150px] bg-zinc-900 flex items-center justify-center text-6xl">${t.banner}</div><div class="p-6"><h1 class="text-[22px] font-black">${t.title}</h1><p class="text-[13px] text-zinc-500">${t.game} • Organized by TournaX</p><div class="grid grid-cols-3 gap-3 mt-5"><div class="bg-zinc-50 border rounded-[14px] p-3"><div class="text-[10px]">PRIZE POOL</div><b>৳${t.prize}</b></div><div class="bg-zinc-50 border rounded-[14px] p-3"><div class="text-[10px]">ENTRY FEE</div><b>৳${t.entry}</b></div><div class="bg-zinc-50 border rounded-[14px] p-3"><div class="text-[10px]">SLOTS</div><b>${t.joined}/${t.total}</b></div></div><div class="mt-6"><b class="text-[14px]">Rules</b><p class="text-[13px] text-zinc-600 mt-2">${t.rules}</p><p class="text-[12px] text-zinc-500 mt-3">• Room ID will be shared in My Orders 10 mins before match<br>• Prize auto credit to wallet<br>• bKash Support: 01344758887</p></div><button onclick="joinT('${t.id}')" class="w-full mt-8 bg-zinc-900 text-white py-4 rounded-full font-black">JOIN NOW - ৳${t.entry}</button><p class="text-[11px] text-center mt-2 text-zinc-500">Secure - Transaction will be handled via Firebase Functions in production</p></div></div></div>`}
 else if(r=='/tournaments'){html=`<div class="max-w-[1100px] mx-auto px-4 py-6"><h1 class="text-[24px] font-black">All Tournaments</h1><input oninput="state.search=this.value;render()" value="${state.search}" placeholder="Search tournaments..." class="w-full mt-4 border rounded-full px-4 py-3 bg-white"><div class="grid md:grid-cols-3 gap-3 mt-5">${TOURNAMENTS.filter(t=>t.title.toLowerCase().includes(state.search.toLowerCase())).map(TC).join('')}</div></div>`}
 else if(r=='/orders'){html=`<div class="max-w-[800px] mx-auto px-4 py-6"><h1 class="text-[22px] font-black">My Orders</h1><div class="mt-4 space-y-3">${DB.orders.length==0?`<div class="bg-white border rounded-[24px] p-12 text-center"><p class="font-bold">No orders yet</p><button onclick="nav('/tournaments')" class="mt-3 bg-zinc-900 text-white px-5 py-2 rounded-full text-[13px]">Browse</button></div>`:DB.orders.map(o=>`<div class="bg-white border rounded-[18px] p-4 flex justify-between"><div><b class="text-[14px]">${o.name}</b><div class="text-[12px] text-zinc-500">#${o.id} • ৳${o.amount} • ${o.date}</div><span class="inline-block mt-2 px-2 py-1 bg-green-50 border border-green-200 text-green-700 rounded-full text-[10px] font-bold">CONFIRMED</span></div><button onclick="nav('/orders/${o.id}')" class="px-4 py-2 border rounded-full text-[12px]">View Room</button></div>`).join('')}</div></div>`}
 else if(r.startsWith('/orders/')){const id=r.split('/')[2];const o=DB.orders.find(x=>x.id==id);html=`<div class="max-w-[600px] mx-auto px-4 py-6"><button onclick="nav('/orders')" class="text-[13px]">← Back</button><div class="bg-white border rounded-[24px] p-6 mt-4">${o?`<h1 class="font-black">Order #${o.id}</h1><div class="mt-4 space-y-2 text-[13px]"><div class="flex justify-between"><span class="text-zinc-500">Tournament</span><b>${o.name}</b></div><div class="flex justify-between"><span class="text-zinc-500">Amount</span><b>৳${o.amount}</b></div></div><div class="mt-6 bg-amber-50 border border-amber-200 rounded-[14px] p-4"><b class="text-[13px]">🎮 Room Info (Live 10 mins before match)</b><p class="text-[13px] mt-2">Room ID: <b> ${Math.floor(1000000+Math.random()*9000000)}</b><br>Password: <b> TournaX123</b></p><p class="text-[11px] mt-2 text-zinc-600">Copy this and join Free Fire Custom Room</p></div>`:'Not found'}</div></div>`}
 else if(r=='/wallet'){html=`<div class="max-w-[800px] mx-auto px-4 py-6"><h1 class="text-[22px] font-black">Wallet</h1><div class="grid md:grid-cols-2 gap-4 mt-4"><div class="bg-zinc-900 text-white rounded-[24px] p-6"><div class="text-zinc-400 text-[11px]">BALANCE</div><div class="text-[36px] font-black">৳${DB.balance}</div><div class="flex gap-2 mt-4"><button onclick="nav('/wallet/deposit')" class="bg-white text-black px-5 py-2 rounded-full font-bold text-[13px]">+ Deposit</button><button onclick="nav('/wallet/withdraw')" class="border border-zinc-700 px-5 py-2 rounded-full text-[13px]">Withdraw</button></div></div><div class="bg-white border rounded-[24px] p-5"><b>Payment Method</b><div class="mt-3 bg-pink-50 border border-pink-200 rounded-[12px] p-3 text-[13px]"><b>bKash Personal (Send Money)</b><br><span class="text-[18px] font-black">01344758887</span></div><button onclick="nav('/transactions')" class="w-full mt-3 border py-2 rounded-full text-[13px]">Transaction History</button></div></div></div>`}
 else if(r=='/wallet/deposit'){html=`<div class="max-w-[500px] mx-auto px-4 py-6"><button onclick="nav('/wallet')" class="text-[13px]">← Wallet</button><h1 class="text-[22px] font-black mt-2">Deposit</h1><div class="bg-white border rounded-[24px] p-6 mt-4"><div class="bg-pink-50 border border-pink-200 rounded-[16px] p-4 text-center"><div class="text-[11px] font-bold text-pink-700">bKash Personal - Send Money</div><div class="text-[24px] font-black">01344758887</div><div class="text-[11px] text-zinc-600 mt-1">1. Send Money to this number<br>2. Copy TrxID from bKash App<br>3. Submit below</div></div><input id="da" type="number" placeholder="Amount Min 50" class="w-full mt-4 border rounded-[12px] px-4 py-3"><input id="ds" placeholder="Your bKash Number" class="w-full mt-3 border rounded-[12px] px-4 py-3"><input id="dt" placeholder="TrxID ex: 9A7F2K1L" class="w-full mt-3 border rounded-[12px] px-4 py-3"><button onclick="dep()" class="w-full mt-4 bg-zinc-900 text-white py-3.5 rounded-full font-bold">Submit Deposit Request</button><p class="text-[11px] text-zinc-500 text-center mt-3">Firebase Function will verify TrxID with bKash API. Demo auto-credit enabled.</p></div></div>`}
 else if(r=='/wallet/withdraw'){html=`<div class="max-w-[500px] mx-auto px-4 py-6"><button onclick="nav('/wallet')" class="text-[13px]">← Wallet</button><h1 class="text-[22px] font-black mt-2">Withdraw</h1><div class="bg-white border rounded-[24px] p-6 mt-4"><div class="bg-zinc-50 border rounded-[12px] p-3 flex justify-between text-[13px]"><span>Available</span><b>৳${DB.balance}</b></div><input id="wa" type="number" placeholder="Amount Min 100" class="w-full mt-4 border rounded-[12px] px-4 py-3"><select id="wm" class="w-full mt-3 border rounded-[12px] px-4 py-3"><option>bKash</option><option>Nagad</option></select><input id="wn" placeholder="Account Number - 01344758887" class="w-full mt-3 border rounded-[12px] px-4 py-3"><button onclick="wd()" class="w-full mt-4 bg-zinc-900 text-white py-3.5 rounded-full font-bold">Request Withdraw</button></div></div>`}
 else if(r=='/transactions'){html=`<div class="max-w-[600px] mx-auto px-4 py-6"><button onclick="nav('/wallet')" class="text-[13px]">← Wallet</button><h1 class="text-[22px] font-black mt-2">Transactions</h1><div class="mt-4 space-y-2">${DB.trx.map(t=>`<div class="bg-white border rounded-[14px] p-4 flex justify-between"><div><b class="text-[13px]">${t.type}</b><div class="text-[11px] text-zinc-500">${t.id} • ${t.date}</div></div><b>৳${t.amt}</b></div>`).join('')||'<div class="bg-white border rounded-[20px] p-10 text-center text-zinc-500 text-[13px]">No transactions</div>'}</div></div>`}
 else if(r=='/profile'){html=`<div class="max-w-[600px] mx-auto px-4 py-6"><h1 class="text-[22px] font-black">Profile</h1><div class="bg-white border rounded-[24px] p-6 mt-4 flex gap-4 items-center"><div class="w-16 h-16 rounded-full bg-zinc-900 text-white flex items-center justify-center text-xl font-black">${DB.user.name[0]}</div><div><div class="font-black">${DB.user.name}</div><div class="text-[12px] text-zinc-500">${DB.user.email} • ${DB.user.phone||'01344758887'}</div><div class="text-[11px] mt-1">ID: ${DB.user.id} • Wallet ৳${DB.balance} • Joined ${DB.orders.length}</div></div></div><div class="mt-4 bg-white border rounded-[24px] divide-y"><button onclick="nav('/profile/edit')" class="w-full p-4 text-left flex justify-between"><span>✏️ Edit Profile</span><span>›</span></button><button onclick="nav('/orders')" class="w-full p-4 text-left flex justify-between"><span>📦 My Orders</span><span>›</span></button><button onclick="nav('/wallet')" class="w-full p-4 text-left flex justify-between"><span>💳 Wallet</span><span>›</span></button><button onclick="nav('/settings')" class="w-full p-4 text-left flex justify-between"><span>⚙️ Settings</span><span>›</span></button><button onclick="logout()" class="w-full p-4 text-left text-red-600 font-bold">Logout</button></div></div>`}
 else if(r=='/profile/edit'){html=`<div class="max-w-[500px] mx-auto px-4 py-6"><button onclick="nav('/profile')" class="text-[13px]">← Profile</button><h1 class="font-black text-[20px] mt-2">Edit Profile</h1><div class="bg-white border rounded-[24px] p-6 mt-4 space-y-3"><input id="en" value="${DB.user.name}" class="w-full border rounded-[12px] px-4 py-3" placeholder="Name"><input id="ee" value="${DB.user.email}" class="w-full border rounded-[12px] px-4 py-3" placeholder="Email"><input id="ep" value="${DB.user.phone||'01344758887'}" class="w-full border rounded-[12px] px-4 py-3" placeholder="Phone"><button onclick="saveP()" class="w-full bg-zinc-900 text-white py-3 rounded-full font-bold">Save Changes</button></div></div>`}
 else{html=`<div class="max-w-[600px] mx-auto px-4 py-10 text-center"><h1 class="font-black text-[20px]">${r}</h1><p class="text-zinc-500 text-[13px] mt-2">This page is ready - Firebase integration point isolated.</p><button onclick="nav('/')" class="mt-4 bg-zinc-900 text-white px-6 py-2 rounded-full">Home</button></div>`}
 const bottom=`<nav class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t flex justify-around py-2 z-30"><button onclick="nav('/')" class="flex flex-col items-center text-[10px]"><span class="text-[18px]">🏠</span>Home</button><button onclick="nav('/tournaments')" class="flex flex-col items-center text-[10px]"><span class="text-[18px]">🏆</span>Tour</button><button onclick="nav('/orders')" class="flex flex-col items-center text-[10px]"><span class="text-[18px]">📦</span>Orders</button><button onclick="nav('/wallet')" class="flex flex-col items-center text-[10px]"><span class="text-[18px]">💳</span>Wallet</button><button onclick="nav('/profile')" class="flex flex-col items-center text-[10px]"><span class="text-[18px]">👤</span>Profile</button></nav>`;
 document.getElementById('app').innerHTML=h+html+bottom;
}
window.doLogin=()=>{const e=document.getElementById('le').value;const p=document.getElementById('lp').value;if(!e||!p){alert('Fill all');return}DB.user={id:'TX-'+Math.floor(10000+Math.random()*90000),name:e.split('@')[0],email:e,phone:'01344758887'};save();nav('/')}
window.doReg=()=>{const n=document.getElementById('rn').value;const e=document.getElementById('re').value;const ph=document.getElementById('rph').value;if(!n||!e){alert('Fill');return}DB.user={id:'TX-'+Math.floor(10000+Math.random()*90000),name:n,email:e,phone:ph||'01344758887'};save();nav('/')}
window.joinT=(id)=>{const t=TOURNAMENTS.find(x=>x.id==id);if(DB.balance<t.entry){if(confirm(`Insufficient ৳${DB.balance} need ৳${t.entry}. Deposit to 01344758887?`))nav('/wallet/deposit');return}if(!confirm(`Confirm Join ${t.title}? ৳${t.entry} will be deducted`))return;DB.balance-=t.entry;const oid='TX'+Math.floor(100000+Math.random()*900000);DB.orders.push({id:oid,name:t.title,amount:t.entry,date:new Date().toLocaleDateString()});DB.trx.unshift({id:oid,type:'Tournament Entry - '+t.title,amt:t.entry,date:new Date().toLocaleDateString()});save();alert('Joined! Order #'+oid);nav('/orders')}
window.dep=()=>{const a=document.getElementById('da').value;const s=document.getElementById('ds').value;const tr=document.getElementById('dt').value;if(!a||!s||!tr){alert('Fill all');return}DB.balance+=Number(a);DB.trx.unshift({id:tr,type:'Deposit bKash 01344758887',amt:a,date:new Date().toLocaleDateString()});save();alert('Deposit Request Submitted TrxID: '+tr+' - In production admin will verify in Firebase Console');nav('/wallet')}
window.wd=()=>{const a=Number(document.getElementById('wa').value);if(a<100||a>DB.balance){alert('Invalid');return}DB.balance-=a;DB.trx.unshift({id:'WD'+Date.now(),type:'Withdraw',amt:a,date:new Date().toLocaleDateString()});save();alert('Withdraw Requested ৳'+a);nav('/wallet')}
window.saveP=()=>{DB.user.name=document.getElementById('en').value;DB.user.email=document.getElementById('ee').value;DB.user.phone=document.getElementById('ep').value;save();alert('Saved');nav('/profile')}
window.logout=()=>{localStorage.clear();location.hash='/login';location.reload()}
render();addEventListener('hashchange',()=>{state.route=location.hash.slice(1)||'/';render()})
</script>
</body>
</html>
